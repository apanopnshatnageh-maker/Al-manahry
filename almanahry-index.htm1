<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>المناهري | للأجهزة المنزلية</title>
<meta name="description" content="المناهري للأجهزة المنزلية - كتالوج المنتجات والعروض والتواصل عبر واتساب">
<style>
:root{--ink:#101114;--muted:#74777c;--line:#e8e8e5;--bg:#f7f7f5;--card:#fff;--accent:#f5b900}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,Arial,sans-serif}
a{text-decoration:none;color:inherit}.wrap{width:min(1180px,92%);margin:auto}
header{position:sticky;top:0;z-index:20;background:#fffffff2;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{height:50px;width:150px;object-fit:contain;object-position:center;mix-blend-mode:multiply}.links{display:flex;gap:28px;font-size:14px;font-weight:600}.admin{border:1px solid #ddd;border-radius:12px;padding:10px 14px;font-size:13px;background:#fff}
.hero{padding:74px 0 62px;background:radial-gradient(circle at 12% 20%,#fff 0 25%,transparent 45%),linear-gradient(135deg,#f2f0eb,#fff)}
.heroGrid{display:grid;grid-template-columns:1.05fr .95fr;gap:65px;align-items:center}.eyebrow{font-size:12px;letter-spacing:1.6px;color:#777;text-transform:uppercase;font-weight:700}.hero h1{font-size:clamp(42px,6.8vw,78px);line-height:1.03;margin:16px 0}.hero h1 em{font-style:normal;color:#70747a}.hero p{color:#686b70;font-size:18px;line-height:1.9;max-width:620px}.actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:13px;padding:13px 20px;font-weight:800;cursor:pointer}.primary{background:#111;color:#fff}.secondary{background:#fff;border:1px solid #ddd}.heroLogo{background:#151619;border-radius:30px;padding:16px;box-shadow:0 30px 80px #0002}.heroLogo img{width:100%;display:block;border-radius:22px}
.section{padding:78px 0}.head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:25px}.head h2{font-size:40px;margin:7px 0}.search{width:290px;border:1px solid #ddd;border-radius:12px;padding:13px 15px;background:#fff;font:inherit}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:25px}.chip{border:1px solid #ddd;background:#fff;border-radius:999px;padding:9px 14px;cursor:pointer}.chip.active{background:#111;color:#fff;border-color:#111}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;transition:.2s}.card:hover{transform:translateY(-3px);box-shadow:0 18px 45px #0000000d}.pic{height:290px;background:#f0f0ee;display:grid;place-items:center}.pic img{width:100%;height:100%;object-fit:contain}.pic .ph{font-size:58px;color:#bbb}.body{padding:18px}.body h3{margin:8px 0 5px;font-size:20px}.desc{min-height:45px;color:#777;line-height:1.65;margin:0}.price{font-size:19px;font-weight:900;margin:14px 0}.wa{display:block;text-align:center;background:#111;color:#fff;padding:11px;border-radius:11px;font-weight:800}
.banner{background:#111;color:#fff;padding:60px 0}.banner h2{font-size:40px;max-width:760px;line-height:1.3;margin:10px 0 25px}.about{background:#fff}.aboutGrid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.about p{font-size:18px;color:#666;line-height:2}
footer{background:#fff;border-top:1px solid var(--line)}.foot{display:grid;grid-template-columns:1fr 1fr;padding:40px 0;gap:30px}.foot img{width:150px;height:50px;object-fit:contain;object-position:right}.foot a{font-weight:700}.copy{border-top:1px solid var(--line);padding:18px 0;color:#888;font-size:12px}
#adminPanel{display:none;position:fixed;inset:0;background:#f7f7f5;z-index:100;overflow:auto}.adminTop{background:#fff;border-bottom:1px solid #ddd;padding:18px 0;position:sticky;top:0}.adminTop .wrap{display:flex;justify-content:space-between;align-items:center}.panel{padding:30px 0;max-width:900px}.box{background:#fff;border:1px solid #e5e5e2;border-radius:18px;padding:22px;margin:15px 0}.box h2{margin-top:0}.box input,.box textarea{width:100%;padding:12px;border:1px solid #ddd;border-radius:10px;margin:7px 0 12px;font:inherit}.box textarea{min-height:90px}.form{display:grid;grid-template-columns:1fr 1fr;gap:8px}.rows{display:grid;gap:8px}.row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px;border:1px solid #eee;border-radius:12px}.del{border:1px solid #ddd;background:#fff;border-radius:9px;padding:8px 12px;cursor:pointer}.note{color:#777;line-height:1.8;font-size:14px}
@media(max-width:760px){.links{display:none}.hero{padding:50px 0}.heroGrid,.aboutGrid{grid-template-columns:1fr}.heroLogo{max-width:430px;margin:auto}.grid{grid-template-columns:1fr}.head{flex-direction:column;align-items:stretch}.search{width:100%}.form{grid-template-columns:1fr}.banner h2{font-size:30px}.foot{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div class="wrap nav">
<img class="logo" src="data:image/jpeg;base64," alt="المناهري">
<nav class="links"><a href="#products">المنتجات</a><a href="#offers">العروض</a><a href="#about">عن المناهري</a><a href="#contact">تواصل معنا</a></nav>
<button class="admin" onclick="openAdmin()">إدارة الموقع</button>
</div></header>

<section class="hero"><div class="wrap heroGrid">
<div><span class="eyebrow">المناهري للأجهزة المنزلية</span><h1>اختار جهازك<br><em>بسهولة.</em></h1><p>كتالوج المناهري للأجهزة المنزلية — شوف المنتجات والمواصفات وتواصل معنا مباشرة للاستفسار والطلب.</p>
<div class="actions"><a class="btn primary" href="#products">تصفح المنتجات</a><a class="btn secondary" id="heroWA" target="_blank">واتساب</a></div></div>
<div class="heroLogo"><img src="data:image/jpeg;base64," alt=""></div>
</div></section>

<section class="section" id="products"><div class="wrap">
<div class="head"><div><span class="eyebrow">Catalog</span><h2>منتجات المناهري</h2></div><input id="search" class="search" placeholder="ابحث عن منتج..."></div>
<div id="chips" class="chips"></div><div id="grid" class="grid"></div>
</div></section>

<section class="banner" id="offers"><div class="wrap"><span class="eyebrow">عروض المناهري</span><h2>منتجات جديدة وعروض مميزة — اسألنا عن المتاح والأسعار.</h2><a class="btn secondary" id="offerWA" target="_blank">اسأل عن العروض</a></div></section>

<section class="section about" id="about"><div class="wrap aboutGrid"><div><span class="eyebrow">About</span><h2>المناهري للأجهزة المنزلية</h2></div><p>موقع المناهري هو كتالوج إلكتروني لعرض الأجهزة المنزلية بصورة واضحة وسريعة، مع إمكانية التواصل مباشرة عبر واتساب.</p></div></section>

<footer id="contact"><div class="wrap foot"><div><img src="data:image/jpeg;base64," alt=""><p>للأجهزة المنزلية</p></div><div><strong>تواصل معنا</strong><p id="phoneView"></p><a id="footWA" target="_blank">مراسلة واتساب</a></div></div><div class="wrap copy">© <span id="year"></span> المناهري — جميع الحقوق محفوظة.</div></footer>

<div id="adminPanel">
<div class="adminTop"><div class="wrap"><strong>لوحة إدارة المناهري</strong><button class="admin" onclick="closeAdmin()">رجوع للموقع</button></div></div>
<div class="wrap panel">
<div class="box"><h2>بيانات التواصل</h2><label>رقم واتساب بصيغة دولية بدون +</label><input id="phoneInput" placeholder="2010XXXXXXXX"><button class="btn primary" onclick="savePhone()">حفظ</button></div>
<div class="box"><h2>إضافة منتج</h2><div class="form">
<input id="n" placeholder="اسم المنتج"><input id="c" placeholder="القسم">
<input id="p" placeholder="السعر"><input id="im" type="file" accept="image/*">
</div><textarea id="d" placeholder="الوصف والمواصفات المختصرة"></textarea>
<button class="btn primary" onclick="addProduct()">إضافة المنتج</button><p class="note">اختار صورة من الآيفون مباشرة. الصورة تُحفظ داخل بيانات المتصفح لهذا الجهاز.</p></div>
<div class="box"><h2>المنتجات الحالية</h2><div id="rows" class="rows"></div></div>
<div class="box"><h2>نسخة احتياطية</h2><button class="btn secondary" onclick="exportData()">تصدير</button> <button class="btn secondary" onclick="resetData()">بيانات البداية</button><textarea id="backup" placeholder="سيظهر هنا ملف البيانات عند التصدير، ويمكن لصق نسخة لاستعادتها."></textarea><button class="btn primary" onclick="importData()">استيراد</button></div>
</div></div>

<script>
const START={phone:"201000000000",products:[
{name:"مبرد صحراوي فريش توربو 40 لتر",category:"تكييفات ومبردات",price:"اسأل عن السعر",image:"assets/product-1.jpeg",desc:"مبرد صحراوي فريش توربو — 40 لتر."},
{name:"بوتاجاز فريش",category:"بوتاجازات",price:"اسأل عن السعر",image:"assets/product-2.jpeg",desc:"بوتاجاز فريش بتصميم ستانلس."},
{name:"مبرد صحراوي فريش توربو 40 لتر",category:"تكييفات ومبردات",price:"اسأل عن السعر",image:"assets/product-3.jpeg",desc:"مبرد صحراوي فريش توربو — 40 لتر."},
{name:"فرن كهربائي فريش Crystal",category:"أفران كهربائية",price:"اسأل عن السعر",image:"assets/product-4.jpeg",desc:"فرن كهربائي فريش Crystal — 40 لتر."},
{name:"مبرد هواء فريش",category:"تكييفات ومبردات",price:"اسأل عن السعر",image:"assets/product-5.jpeg",desc:"مبرد هواء فريش للمساحات المنزلية."}
]};
function get(){try{return JSON.parse(localStorage.getItem("almanahry_v2"))||START}catch(e){return START}}
function save(x){localStorage.setItem("almanahry_v2",JSON.stringify(x))}
let data=get(),active="الكل";
const wa=(msg="")=>`https://wa.me/${data.phone}?text=${encodeURIComponent(msg)}`;
document.getElementById("year").textContent=new Date().getFullYear();
function links(){document.getElementById("heroWA").href=wa("مرحباً، أريد الاستفسار عن منتجات المناهري.");document.getElementById("offerWA").href=wa("مرحباً، أريد معرفة عروض المناهري.");document.getElementById("footWA").href=wa("مرحباً، أريد الاستفسار عن منتجات المناهري.");document.getElementById("phoneView").textContent="واتساب: +"+data.phone}
function render(){
 const cats=["الكل",...new Set(data.products.map(x=>x.category))];
 document.getElementById("chips").innerHTML=cats.map(x=>`<button class="chip ${x===active?"active":""}" onclick="setCat('${esc(x)}')">${x}</button>`).join("");
 const q=document.getElementById("search").value.toLowerCase().trim();
 const ps=data.products.filter(x=>(active==="الكل"||x.category===active)&&(!q||(x.name+x.category+x.desc).toLowerCase().includes(q)));
 document.getElementById("grid").innerHTML=ps.length?ps.map(x=>`<article class="card"><div class="pic">${x.image?`<img src="${x.image}" alt="${esc(x.name)}">`:`<div class="ph">م</div>`}</div><div class="body"><span class="eyebrow">${esc(x.category)}</span><h3>${esc(x.name)}</h3><p class="desc">${esc(x.desc)}</p><div class="price">${esc(x.price)}</div><a class="wa" target="_blank" href="${wa("مرحباً، أريد الاستفسار عن: "+x.name)}">استفسر عبر واتساب</a></div></article>`).join(""):`<div style="grid-column:1/-1;text-align:center;padding:50px;color:#888">لا توجد منتجات مطابقة.</div>`;
 links();
}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function setCat(x){active=x;render()}
document.getElementById("search").addEventListener("input",render);
function openAdmin(){document.getElementById("adminPanel").style.display="block";document.getElementById("phoneInput").value=data.phone;renderAdmin()}
function closeAdmin(){document.getElementById("adminPanel").style.display="none";render()}
function savePhone(){data.phone=document.getElementById("phoneInput").value.replace(/\D/g,"");save(data);alert("تم حفظ رقم واتساب");render()}
function addProduct(){
 const name=document.getElementById("n").value.trim();if(!name)return alert("اكتب اسم المنتج");
 const file=document.getElementById("im").files[0];
 const finish=(img)=>{data.products.unshift({name,category:document.getElementById("c").value||"أخرى",price:document.getElementById("p").value||"اسأل عن السعر",image:img,desc:document.getElementById("d").value||""});save(data);["n","c","p","d"].forEach(id=>document.getElementById(id).value="");document.getElementById("im").value="";renderAdmin();render();alert("تمت إضافة المنتج")};
 if(file){const r=new FileReader();r.onload=()=>finish(r.result);r.readAsDataURL(file)}else finish("");
}
function renderAdmin(){document.getElementById("rows").innerHTML=data.products.map((x,i)=>`<div class="row"><div><strong>${esc(x.name)}</strong><div style="color:#777;font-size:13px">${esc(x.category)} — ${esc(x.price)}</div></div><button class="del" onclick="delProduct(${i})">حذف</button></div>`).join("")}
function delProduct(i){if(confirm("حذف المنتج؟")){data.products.splice(i,1);save(data);renderAdmin();render()}}
function exportData(){document.getElementById("backup").value=JSON.stringify(data)}
function importData(){try{const x=JSON.parse(document.getElementById("backup").value);if(!x.products)throw 0;data=x;save(data);renderAdmin();render();alert("تم الاستيراد")}catch(e){alert("بيانات غير صحيحة")}}
function resetData(){if(confirm("إرجاع المنتجات الأصلية؟")){data=JSON.parse(JSON.stringify(START));save(data);renderAdmin();render()}}
render();
</script>
</body></html>